--recurse=yes
--sort=yes
--languages=JavaScript,TypeScript
--fields=+n+l+S
--extras=-{anonymous}
--exclude=.chrome_data
--exclude=.git
--exclude=.agents
--exclude=node_modules
--exclude=dist
--exclude=build
--exclude=standalone.html
--exclude=index.html
--exclude=src/web/index.html
--exclude=src/original_script.js
--exclude=src/reference_original.js
--exclude=career_summary.txt
--exclude=*.json
--exclude=*.min.js
--exclude=*.map
--exclude=tags
